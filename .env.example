COMPOSE_PROJECT_NAME=redflag
# ─── RedFlag environment (copy to .env for local runs) ───

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=4001
WEB_PUBLIC_URL=http://localhost:4001
# As deployed: users reach the API through the web's domain (the web proxies /api/* to the API).
API_PUBLIC_URL=http://localhost:4001

# PostgreSQL (matches docker-compose; host port 5433 avoids clashing with another Postgres)
POSTGRES_USER=redflag
POSTGRES_PASSWORD=redflag
POSTGRES_DB=redflag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://redflag:redflag@localhost:5433/redflag?schema=public

# Redis (rate limiting for the auth routes; host port 6380 avoids clashing with another Redis)
# Unset → limits are counted in-process, which only holds for a single instance.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ─── Mail ───
# Which way mail goes out: resend | smtp. Left empty, RESEND_API_KEY decides (set → Resend).
MAIL_TRANSPORT=
# Resend (production). The sending domain must be verified in Resend, with SPF/DKIM/DMARC — R3.
RESEND_API_KEY=

# SMTP (dev = Mailpit; also works for any other SMTP provider)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The address simulated test emails come from too — only the DISPLAY NAME imitates a brand (R3/R4).
# In production use a sending domain WITHOUT the product name: an address reading "redflag" tells the
# learner it is an exercise before they get a chance to spot the real signs.
MAIL_FROM="RedFlag <no-reply@redflag.local>"

# Email tests (Phase 4): host the tracked links in test emails point at. Must be a RedFlag-owned
# domain, but WITHOUT the product name — a link reading "redflag" would give the exercise away.
# Dev: the API itself.
TRACKING_PUBLIC_URL=http://localhost:4000

# Inbox that accepts forwarded exercise emails, shown in the instructions users agree to.
REPORT_EMAIL=report@redflag.local
# Forwarded reports come in through Resend Inbound: REPORT_EMAIL must be on a domain receiving mail in
# Resend, with a webhook for `email.received` pointed at <API public URL>/api/inbound/resend. Add
# `email.bounced` and `email.complained` to the SAME webhook: a hard bounce pauses that user's tests,
# a spam complaint turns them off. This is that webhook's signing secret (whsec_…). Empty = forwarded
# reports and bounce handling are turned off.
RESEND_WEBHOOK_SECRET=

# Local hours during which a test email may arrive (R8) — the user's own time zone, not the server's.
SEND_WINDOW_START=8
SEND_WINDOW_END=20

# How often the worker plans and sends (ms). Lower it when trying the flow out locally.
WORKER_TICK_MS=60000

# i18n
DEFAULT_LOCALE=en

# Auth (use a long random string in real deployments)
SESSION_SECRET=change-me-in-production

# ─── Vercel deploy (see docs/deploy-vercel.md) ───
# API: Vercel Cron calls /api/cron/daily with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# The web's own variables live in apps/web/.env.example.

# Admin (Phase 3B): comma-separated emails promoted to admin on sign-in / seed
ADMIN_EMAILS=

# Sign in with Google (optional). Empty → the button is hidden and the routes 404.
# Redirect URI to register in the Google console: <API_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/auth/google/callback
