COMPOSE_PROJECT_NAME=redflag
# ─── RedFlag environment (copy to .env for local runs) ───

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=4001
WEB_PUBLIC_URL=http://localhost:4001
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL (matches docker-compose; host port 5433 avoids clashing with another Postgres)
POSTGRES_USER=redflag
POSTGRES_PASSWORD=redflag
POSTGRES_DB=redflag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://redflag:redflag@localhost:5433/redflag?schema=public

# Redis (BullMQ; host port 6380 avoids clashing with another Redis)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# SMTP (dev = Mailpit; prod = real SMTP with SPF/DKIM/DMARC — R3)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="RedFlag <no-reply@redflag.local>"

# i18n
DEFAULT_LOCALE=en

# Auth (use a long random string in real deployments)
SESSION_SECRET=change-me-in-production

# Admin (Phase 3B): comma-separated emails promoted to admin on sign-in / seed
ADMIN_EMAILS=
