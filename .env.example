# ─── PhishGym environment (sao chép sang .env để chạy local) ───

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL (khớp docker-compose; dùng 5433 ở host để tránh đụng Postgres khác)
POSTGRES_USER=phishgym
POSTGRES_PASSWORD=phishgym
POSTGRES_DB=phishgym
POSTGRES_PORT=5433
DATABASE_URL=postgresql://phishgym:phishgym@localhost:5433/phishgym?schema=public

# Redis (BullMQ; dùng 6380 ở host để tránh đụng Redis khác)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# SMTP (dev = Mailpit; prod = SMTP thật, cấu hình SPF/DKIM/DMARC — R3)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="PhishGym <no-reply@phishgym.local>"

# i18n
DEFAULT_LOCALE=en

# Auth (đặt chuỗi ngẫu nhiên dài khi dùng thật)
SESSION_SECRET=change-me-in-production
