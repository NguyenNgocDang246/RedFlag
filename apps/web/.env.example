# Web (Next.js). Next only reads env files inside apps/web, so these are separate from the root .env.
# Same layout as on Vercel: the browser only talks to the web, which proxies /api/* to the API.

# Where the web proxies /api/* (the API itself).
API_PROXY_URL=http://localhost:4000
# Where the web server calls the API directly when rendering pages.
API_PUBLIC_URL=http://localhost:4000
# Where browser code calls the API: the web itself, so auth cookies stay on the web domain.
NEXT_PUBLIC_API_URL=http://localhost:4001
