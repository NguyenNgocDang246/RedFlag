// RedFlag — Prisma schema
// Organized by bounded context (see plan/architecture.md §4, §8).
// Architectural constraints: R2 (events carry NO PII), R5 (per-user isolation),
// R6 (content is data, translated via *_translations tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Locale {
  en
  vi
}

enum EventType {
  opened
  clicked
  submitted // reached the fake form's submit step — signal only, input is NOT stored (R2)
  reported
  ignored
}

enum TestFrequency {
  off
  low
  medium
  high
}

enum DeliveryChannel {
  email
}

enum DeliveryStatus {
  queued
  sent
  bounced
  complained
  failed
}

enum CampaignStatus {
  scheduled
  sent
  expired
}

enum ConsentType {
  terms
  test_flow
}

enum TrackingPurpose {
  open
  click
  submit
  report // "Report scam" link in the email — click emits a `reported` event (good signal). R2: signal only.
}

enum UserRole {
  user
  admin // content editor (Phase 3B) — granted via ADMIN_EMAILS env
}

// Contest (Phase 3A): server-authoritative graded round.
enum ContestStatus {
  active
  finished
}

// How a contest item was closed. Anything but `answered` scores 0.
enum ContestOutcome {
  answered
  forfeited // served again before answering (reload / back / reopened link)
  timeout // answered after the deadline, or never answered in time
}

// Drafts are admin-only; only `published` quizzes appear on /practice and /train.
enum ContentStatus {
  draft
  published
}

// On-site simulated quiz kinds (Group 2 — no email sent).
enum QuizKind {
  email_inspection
  popup // fake popup/tech support
  oauth_consent // fake OAuth consent screen
  sms_inspection // SMS / brandname message
  chat_inspection // chat (borrowing money, asking for votes...)
  web_inspection // fake website (shop/fanpage/login)
  qr_inspection // QR code leading to a strange domain
  file_inspection // fake attachment / "enable content"
  app_consent // app install + excessive permissions
}

// ─────────────────────── Context: identity ───────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String? // optional (R9)
  occupation      String? // optional — personalizes simulated spear-phishing
  servicesUsed    String[]  @default([]) // frequently used services (optional)
  locale          Locale    @default(en)
  role            UserRole  @default(user)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consents      Consent[]
  trainingPrefs UserTrainingPrefs?
  testOptin     UserTestOptin?
  verifications EmailVerification[]
  sessions      Session[]
  campaigns     Campaign[]
  events        Event[]
  score         UserScore?
  quizAttempts  QuizAttempt[]
  contests      ContestSession[]
  auditLogs     AuditLog[]
}

// Sign-in session (refresh token stored in the DB, revocable).
// The access token is a short-lived JWT (verified without touching the DB);
// the refresh token is opaque and only its HASH (sha256) is stored — never the raw value.
model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique // sha256 of the current refresh token (rotated on every refresh)
  // Previous token + rotation time: concurrent refreshes within the grace window still succeed;
  // reuse after it revokes the session (see SessionService.rotate).
  prevTokenHash String?
  rotatedAt     DateTime?
  userAgent     String? // lets users recognize sessions when managing them
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prevTokenHash])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Consent {
  id        String      @id @default(cuid())
  userId    String
  type      ConsentType
  grantedAt DateTime    @default(now())
  revokedAt DateTime?

  // Type-to-confirm evidence when enabling Test flow (not PII).
  textVersion      String? // warning text version shown
  locale           Locale? // locale of the confirmation phrase
  confirmationText String? // phrase the user typed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Training settings — separate from Test so each can be toggled independently (2 flows ⟂).
model UserTrainingPrefs {
  id        String   @id @default(cuid())
  userId    String   @unique
  interests String[] @default([]) // category codes of interest
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Test flow opt-in — fully independent of Training (R1).
model UserTestOptin {
  id        String        @id @default(cuid())
  userId    String        @unique
  enabled   Boolean       @default(false)
  frequency TestFrequency @default(off)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────── Context: catalog ───────────────────────
// Content is DATA (R6). New scam types = new rows, no code changes.
// Display fields live in *_translations tables (multilingual, en by default).

model Signal {
  id        String   @id @default(cuid())
  code      String   @unique // matches SignalCode in @redflag/shared
  createdAt DateTime @default(now())

  translations     SignalTranslation[]
  variantSignals   VariantSignal[]
  reportedInEvents Event[]
  quizSignals      QuizQuestionSignal[]
}

model SignalTranslation {
  id          String @id @default(cuid())
  signalId    String
  locale      Locale
  name        String
  explanation String

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId, locale])
}

model Category {
  id           String   @id @default(cuid())
  code         String   @unique // matches CategoryCode in @redflag/shared
  impersonates String[] @default([]) // impersonated brand examples (data, multi-region)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  translations  CategoryTranslation[]
  templates     Template[]
  quizQuestions QuizQuestion[]
  brands        Brand[]
}

model CategoryTranslation {
  id          String  @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Template {
  id         String   @id @default(cuid())
  categoryId String
  code       String   @unique // e.g. BANK-001
  createdAt  DateTime @default(now())

  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations TemplateTranslation[]
  variants     Variant[]

  @@index([categoryId])
}

model TemplateTranslation {
  id             String @id @default(cuid())
  templateId     String
  locale         Locale
  subjectPattern String
  bodyPattern    String

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, locale])
}

model Variant {
  id              String   @id @default(cuid())
  templateId      String
  difficultyLevel Int      @default(1) // 1 = easy
  createdAt       DateTime @default(now())

  template     Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  translations VariantTranslation[]
  signals      VariantSignal[]
  campaigns    Campaign[]

  @@index([templateId])
}

model VariantTranslation {
  id              String @id @default(cuid())
  variantId       String
  locale          Locale
  renderedSubject String
  renderedBody    String

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locale])
}

// Variant ↔ Signal (many-to-many): metadata for signal-based grading (R7).
model VariantSignal {
  variantId String
  signalId  String

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  signal  Signal  @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@id([variantId, signalId])
  @@index([signalId])
}

// On-site simulated quiz (Training part b). NO email sent; graded on the server.
model QuizQuestion {
  id              String        @id @default(cuid())
  number          Int           @unique @default(autoincrement()) // sequence number #1, #2… for the library
  kind            QuizKind
  isScam          Boolean // correct answer to "safe / scam"
  difficultyLevel Int           @default(1)
  categoryId      String?
  isPublic        Boolean       @default(false) // guests can take it (public set)
  order           Int           @default(0)
  status          ContentStatus @default(published)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  category     Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations QuizQuestionTranslation[]
  signals      QuizQuestionSignal[] // CORRECT signals the user should spot
  attempts     QuizAttempt[]
  contestItems ContestItem[]

  @@index([categoryId])
}

model QuizQuestionTranslation {
  id           String  @id @default(cuid())
  questionId   String
  locale       Locale
  title        String? // neutral library title — must NOT reveal the answer
  prompt       String
  scenario     String // flat text (SEO + fallback when there's no scenarioData)
  scenarioData Json? // structured per-channel content + hotspots (see ScenarioData in @redflag/shared)
  explanation  String // shown after grading

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
}

// Correct signals for a quiz question (signal-based grading — R7).
model QuizQuestionSignal {
  questionId String
  signalId   String

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  signal   Signal       @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@id([questionId, signalId])
  @@index([signalId])
}

// Brand handbook: brands' REAL contact channels so learners can cross-check.
// One brand set per locale (VI quizzes use vi brands, EN quizzes use en brands), so
// descriptions live on the row itself, with no translation table.
// Not tied to individual questions (a shared reference, like looking things up in real life).
model Brand {
  id           String        @id @default(cuid())
  code         String // e.g. SAOMAI_BANK — unique within a locale
  locale       Locale
  name         String
  description  String        @default("")
  categoryId   String?
  websites     String[]      @default([])
  emailDomains String[]      @default([])
  smsSenders   String[]      @default([]) // brandname SMS
  hotlines     String[]      @default([])
  apps         String[]      @default([]) // "App name — Publisher"
  socialPages  String[]      @default([])
  order        Int           @default(0)
  status       ContentStatus @default(published)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([code, locale])
  @@index([locale])
  @@index([categoryId])
}

// Quiz attempts by signed-in users (basis for progress/scoring later).
// Guests do NOT create attempts. Contains NO PII.
model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String
  questionId      String
  answeredScam    Boolean // user picked "scam"?
  classifyCorrect Boolean // safe/scam classified correctly?
  selectedSignals String[] @default([]) // signal codes the user picked
  createdAt       DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

// A contest round (Phase 3A). The server draws the questions, serves them one at a time
// and grades them; the client never sees answers until the round is finished. Contains NO PII.
model ContestSession {
  id           String        @id @default(cuid())
  userId       String
  locale       Locale
  status       ContestStatus @default(active)
  itemSeconds  Int // time limit per question
  currentIndex Int           @default(0) // position of the question being worked on
  score        Int           @default(0)
  maxScore     Int           @default(0)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ContestItem[]

  @@index([userId, status])
}

// One question in a contest round. Locked once `outcome` is set.
model ContestItem {
  id              String          @id @default(cuid())
  sessionId       String
  position        Int
  questionId      String
  servedAt        DateTime? // first (and only) time the question was shown
  answeredAt      DateTime?
  outcome         ContestOutcome?
  answeredScam    Boolean?
  selectedSignals String[]        @default([])
  // Hotspot keys picked ("SIGNAL|text", "|text" = plain text) — our own content, for the review screen.
  selectedSpots   String[]        @default([])
  classifyCorrect Boolean?
  points          Int             @default(0)
  maxPoints       Int

  session  ContestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
  @@index([questionId])
}

// ─────────────────────── Context: admin ───────────────────────

// Content edit log (who changed what, when). Only admin actions on the catalog,
// never other users' personal data (R5).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // create | update | delete | publish | unpublish
  entity    String // category | signal | quiz | brand
  entityId  String
  changes   Json? // snapshot after the change (or before deletion)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────── Context: testing ───────────────────────

model Campaign {
  id          String          @id @default(cuid())
  userId      String
  variantId   String
  channel     DeliveryChannel @default(email)
  status      CampaignStatus  @default(scheduled)
  scheduledAt DateTime
  sentAt      DateTime?
  createdAt   DateTime        @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant  Variant         @relation(fields: [variantId], references: [id])
  delivery Delivery?
  tokens   TrackingToken[]
  events   Event[]

  @@index([userId])
  @@index([scheduledAt])
}

// ─────────────────────── Context: delivery ───────────────────────

model Delivery {
  id                String         @id @default(cuid())
  campaignId        String         @unique
  status            DeliveryStatus @default(queued)
  providerMessageId String?
  updatedAt         DateTime       @updatedAt
  createdAt         DateTime       @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─────────────── Context: tracking (R2 safety boundary) ───────────────

// Opaque per-campaign token, expirable/revocable (R5). NOT PII.
model TrackingToken {
  id         String          @id @default(cuid())
  token      String          @unique
  campaignId String
  purpose    TrackingPurpose
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// Event = SIGNAL. Never any field holding user-entered data (R2).
model Event {
  id               String    @id @default(cuid())
  campaignId       String
  userId           String
  type             EventType
  reportedSignalId String? // when the user reports + picks the suspicious sign (multiple choice)
  createdAt        DateTime  @default(now())

  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportedSignal Signal?  @relation(fields: [reportedSignalId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([userId])
}

// ─────────────────────── Context: scoring ───────────────────────

// Read projection for the dashboard; the events table is the source of truth.
model UserScore {
  userId         String   @id
  awarenessScore Float    @default(0)
  weakSignals    Json     @default("[]") // weak signal codes
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
